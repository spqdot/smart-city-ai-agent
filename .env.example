# Copy to .env (git-ignored) or set as environment variables.
# Provider: openai (default) | ollama
LLM_PROVIDER=openai
# Optional. Defaults: gpt-4o-mini (openai), llama3.1:8b (ollama)
# LLM_MODEL=gpt-4o-mini
# Optional. Use for Ollama (http://localhost:11434) or any OpenAI-compatible server.
# LLM_BASE_URL=
# Required for openai. Never commit a real key.
# Optional. Free OpenStreetMap lookup for landmarks (sends only the place text).
# Set to "none" to stay fully offline.
# GEOCODER=nominatim
# Optional. Path to the timetable index made by `python build_timetable.py`.
# TIMETABLE_PATH=data/processed/timetable.sqlite
OPENAI_API_KEY=
